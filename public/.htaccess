# Apache config for /kevin static Next export (not an SPA).
# Real files only — unknown paths 404 (no client-side rewrite).

Options -Indexes
DirectoryIndex index.html

# Correct MIME types (avoids text/html-as-stylesheet when mis-served)
AddType text/css .css
AddType application/javascript .js
AddType text/javascript .js
AddType font/woff2 .woff2
AddType image/webp .webp
AddType image/png .png
AddType image/svg+xml .svg

<IfModule mod_headers.c>
  # Hashed Next/_next assets + images: long cache
  <FilesMatch "\.(?:js|css|woff2|png|webp|svg|ico|jpg|jpeg|gif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML must revalidate so deploys show up and 404s are not sticky
  <FilesMatch "\.(?:html|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Never let the custom 404 document be cached as a “successful” asset
  <If "%{REQUEST_STATUS} == 404">
    Header always set Cache-Control "no-store, no-cache, must-revalidate"
  </If>
</IfModule>

# Prefer exact files; fall through to branded 404 HTML (status stays 404).
ErrorDocument 404 /kevin/404.html
