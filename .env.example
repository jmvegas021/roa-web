# IDX Broker credentials (server-only — never NEXT_PUBLIC_)
IDX_API_KEY=
IDX_ACCOUNT_ID=
IDX_ANCILLARY_KEY=
IDX_API_VERSION=1.8.0

# Canonical production URL (required for correct OG/sitemap/canonicals)
NEXT_PUBLIC_SITE_URL=https://www.kevinshoun.com

# From IDX widgets (e.g. //kevinshoun.idxbroker.com/idx/widgets/157760)
NEXT_PUBLIC_IDX_SUBDOMAIN=kevinshoun.idxbroker.com
NEXT_PUBLIC_IDX_SHOWCASE_ID=157760
NEXT_PUBLIC_IDX_MAP_SEARCH_ID=157763
NEXT_PUBLIC_IDX_QUICK_SEARCH_ID=

# Lead inbox (Resend). Defaults to kevin.shoun@realtyofamerica.com if unset.
LEAD_NOTIFY_EMAIL=kevin.shoun@realtyofamerica.com
RESEND_API_KEY=
# Optional From override if kevinshoun.com is not verified on Resend yet
RESEND_FROM_EMAIL=
LEAD_FROM_EMAIL=Office of Kevin Shoun <noreply@kevinshoun.com>

# Blog publish API (Claude Desktop / Cowork). Not used by the public site.
# Fine-grained PAT: Contents write on jmvegas021/roa-web only.
BLOG_PUBLISH_SECRET=
BLOG_GITHUB_TOKEN=
BLOG_GITHUB_OWNER=jmvegas021
BLOG_GITHUB_REPO=roa-web
BLOG_GITHUB_BRANCH=main

# Weekly GitHub Action only (repo Actions secret). Not needed on Kevin's computer.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
