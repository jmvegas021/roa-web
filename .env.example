# IDX Broker credentials (server-only on Vercel — never expose to the client)
IDX_API_KEY=
IDX_ACCOUNT_ID=

# Optional partner ancillary key (increases rate limits)
IDX_ANCILLARY_KEY=

# API version override (semver, e.g. 1.8.0)
IDX_API_VERSION=1.8.0

# Canonical site URL (OG + metadata) — Vercel production example:
NEXT_PUBLIC_SITE_URL=https://roa-web-tau.vercel.app

# Only for static FTP builds (npm run build:static). Leave unset on Vercel.
# NEXT_PUBLIC_BASE_PATH=/kevin

# IDX subdomain for widgets & dynamic wrapper (e.g. youraccount.idxbroker.com)
NEXT_PUBLIC_IDX_SUBDOMAIN=

# Widget IDs from IDX Control Panel (optional — widgets degrade gracefully)
NEXT_PUBLIC_IDX_QUICK_SEARCH_ID=
NEXT_PUBLIC_IDX_SHOWCASE_ID=

# --- Optional FTP static deploy (scripts/deploy-ftp.mjs) ---
# FTP_HOST=ftp.dudewheresmyweb.site
# FTP_USER=dude
# FTP_PASSWORD=
# FTP_REMOTE=kevin
